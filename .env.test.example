# CHAMBA — Entorno de TEST (plantilla)
#
# Copiá este archivo a `.env.test` y completá con las credenciales de un
# SEGUNDO proyecto Supabase (gratis) dedicado a pruebas de caos/e2e.
#
# NUNCA pongas aquí la URL de producción (xvolxgonpjzjkytpsmil).
# El SYSTEM GUARD (scripts/_guard.mjs) bloquea cualquier script de test que
# apunte a producción.

NODE_ENV=test

# Proyecto Supabase de TEST (distinto al de producción)
EXPO_PUBLIC_SUPABASE_URL=https://TU_PROYECTO_TEST.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=TU_ANON_KEY_DE_TEST
