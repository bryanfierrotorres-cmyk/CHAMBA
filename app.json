{
  "expo": {
    "name": "CHAMBA",
    "slug": "chamba",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#111827"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.chamba.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "CHAMBA usa tu ubicación al publicar una solicitud y para que el técnico pueda guiarse hasta tu domicilio.",
        "NSCameraUsageDescription": "CHAMBA necesita la cámara para subir fotos de perfil y documentos.",
        "NSPhotoLibraryUsageDescription": "CHAMBA necesita acceso a tus fotos para tu perfil."
      }
    },
    "android": {
      "package": "com.chamba.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#111827"
      },
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA",
        "VIBRATE",
        "POST_NOTIFICATIONS"
      ],
      "softwareKeyboardLayoutMode": "pan"
    },
    "web": {
      "favicon": "./assets/images/icon-512.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "CHAMBA usa tu ubicación para compartir dónde necesitás el servicio y para que el técnico pueda llegar."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#22C55E"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 23,
            "compileSdkVersion": 34,
            "targetSdkVersion": 34
          }
        }
      ],
      "expo-font",
      "@maplibre/maplibre-react-native"
    ],
    "scheme": "chamba",
    "extra": {
      "eas": {
        "projectId": "f66f053c-93e5-4170-ba77-a665f70c5772"
      }
    }
  }
}
