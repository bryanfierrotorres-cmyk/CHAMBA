{
  "name": "chamba",
  "version": "1.0.0",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web --port 8091 --clear",
    "web:open": "npx serve dist-web-test -l 8090",
    "build:web": "expo export -p web --output-dir dist-web-test",
    "build:android": "eas build --platform android --profile production",
    "build:android:preview": "eas build --platform android --profile preview",
    "build:android:dev": "eas build --platform android --profile development",
    "lint": "eslint . --ext .ts,.tsx",
    "db:sync-chamba": "node scripts/apply-chamba-schema.mjs",
    "db:apply-catalog": "node scripts/apply-catalog-migration.mjs",
    "db:provision-catalog": "node scripts/provision-catalog.mjs",
    "test:chamba-flow": "node scripts/test-chamba-flow.mjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "~3.2.3",
